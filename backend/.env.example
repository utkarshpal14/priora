PROJECT_NAME=Priora API
ENVIRONMENT=development
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080","*"]

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/priora

# Supabase Auth & JWT
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google OAuth Client
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Email Service (Option 1: Brevo HTTPS REST API - Cloud Verified, No Domain Required)
BREVO_API_KEY=xkeysib-your_brevo_api_key
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=Priora

# Email Service (Option 2: Resend API)
# RESEND_API_KEY=re_your_resend_api_key

# Email Service (Option 2: SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=True
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# In-App Update Management (ENH-006 / TS-008)
LATEST_APP_VERSION=1.1.3
MIN_SUPPORTED_APP_VERSION=1.0.0
APK_DOWNLOAD_URL=https://github.com/utkarshpal14/priora/releases/download/v1.1.3/priora-v1.1.3-release.apk
APP_RELEASE_NOTES=• Email verification & 6-digit hashed OTP system\n• Dedicated Google Cloud OAuth 2.0 Project\n• Bug fixes and stability improvements
FORCE_APP_UPDATE=false
