PROJECT_NAME=Priora API
ENVIRONMENT=development
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080","*"]

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/priora

# Supabase Auth & JWT
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google OAuth Client
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Email Service (Resend API - Production Domain: priorapp.co.in)
RESEND_API_KEY=re_your_resend_api_key
EMAILS_FROM_EMAIL=verify@priorapp.co.in
EMAILS_FROM_NAME=Priora

# Email Service (Option 2: SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=True
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# In-App Update Management (ENH-006 / TS-008)
LATEST_APP_VERSION=1.1.3
MIN_SUPPORTED_APP_VERSION=1.0.0
APK_DOWNLOAD_URL=https://github.com/utkarshpal14/priora/releases/download/v1.1.3/priora-v1.1.3-release.apk
APP_RELEASE_NOTES=• Forgot Password & Password Reset with 6-digit OTP\n• Email Verification with Hashed 6-Digit OTP\n• Global JWT Session Invalidation on Password Reset\n• Verified transactional email delivery via verify@priorapp.co.in\n• Google OAuth 2.0 Sign-In\n• Official com.priora.app package with production signing
FORCE_APP_UPDATE=false
